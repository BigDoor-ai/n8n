    {
      "parameters": {
        "jsCode": "function value(row, ...keys) {\n  for (const key of keys) {\n    if (row && row[key] !== undefined && row[key] !== null && String(row[key]).trim() !== '') {\n      return String(row[key]).trim();\n    }\n  }\n  return '';\n}\n\nconst input = $node['When Executed by Router'].json || {};\nconst userId = String(input.user_id || input.User_ID || '').trim();\nconst chatId = input.chat_id || input.Chat_ID || '';\nconst claimId = String(input.claim_id || input.related_claim_id || input.Claim_ID || '').trim();\nconst claims = $items('Read Claims tab').map((item) => item.json || {});\n\nconst claim = claims.find((row) => {\n  return value(row, 'Claim_ID') === claimId &&\n    value(row, 'User_ID') === userId &&\n    value(row, 'Claim_Status') === 'Approved for Sending' &&\n    value(row, 'User_Approval_Status') === 'Approved';\n});\n\nif (!claim) {\n  return [{ json: { ...input, can_send: false, approved_claim_found: false, error_code: 'approved_claim_not_found', error_reply: 'I could not find an approved claim ready to send. Please start the claim again.', claim_id: claimId, user_id: userId, chat_id: chatId } }];\n}\n\nreturn [{\n  json: {\n    ...input,\n    approved_claim_found: true,\n    claim_id: claimId,\n    user_id: userId,\n    chat_id: chatId,\n    claim_product_id: value(claim, 'Product_ID'),\n    issue_description: value(claim, 'Issue_Description'),\n    claim_email_to: value(claim, 'Claim_Email_To'),\n    claim_email_subject: value(claim, 'Claim_Email_Subject'),\n    claim_email_body: value(claim, 'Claim_Email_Body'),\n  }\n}];"
      },
      "id": "3ff6b083-bb61-430c-94d3-6cda89650872",
      "name": "Find Approved Claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -736,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "function value(row, ...keys) {\n  for (const key of keys) {\n    if (row && row[key] !== undefined && row[key] !== null && String(row[key]).trim() !== '') {\n      return String(row[key]).trim();\n    }\n  }\n  return '';\n}\n\nfunction addDays(date, days) {\n  const copy = new Date(date);\n  copy.setUTCDate(copy.getUTCDate() + days);\n  return copy;\n}\n\nfunction yyyyMmDd(date) {\n  return date.toISOString().slice(0, 10);\n}\n\nconst found = $json || {};\nif (found.can_send === false && found.error_reply) {\n  return [{ json: found }];\n}\n\nconst userId = String(found.user_id || '').trim();\nconst chatId = found.chat_id || '';\nconst claimId = String(found.claim_id || '').trim();\nconst users = $items('Read Users tab').map((item) => item.json || {});\nconst products = $items('Read Products tab').map((item) => item.json || {});\n\nconst user = users.find((row) => value(row, 'User_ID', 'user_id') === userId);\nconst userEmail = value(user, 'Email', 'user_email');\n\nif (!userEmail) {\n  return [{ json: { ...found, can_send: false, error_code: 'missing_user_email', error_reply: 'Please save your email first using /setemail yourname@example.com. I need this to CC you on the claim email.', claim_id: claimId, user_id: userId, chat_id: chatId } }];\n}\n\nconst productId = value(found, 'claim_product_id', 'related_product_id');\nconst product = products.find((row) => value(row, 'Product_ID') === productId) || {};\nconst toEmail = value(found, 'claim_email_to') || value(product, 'Support_Email');\n\nif (!toEmail) {\n  return [{ json: { ...found, can_send: false, error_code: 'missing_support_email', error_reply: 'I could not find a support email for this product. Please share the support email or update the product record.', claim_id: claimId, user_id: userId, chat_id: chatId } }];\n}\n\nconst productName = value(product, 'Product_Name') || 'Product';\nconst invoiceNumber = value(product, 'Invoice_Number') || 'Not available';\nconst userName = value(user, 'Name') || value(found, 'user_name') || 'ClaimMate User';\nconst userPhone = value(user, 'Phone');\nconst issueDescription = value(found, 'issue_description') || 'Issue details were not provided.';\nconst subject = value(found, 'claim_email_subject') || 'Warranty Claim Request for ' + productName + ' - Invoice No. ' + invoiceNumber;\nconst fallbackBody = [\n  'Dear Support Team,',\n  '',\n  'I am writing to raise a warranty claim for the following product:',\n  '',\n  'Product Name: ' + productName,\n  'Brand: ' + value(product, 'Brand'),\n  'Category: ' + value(product, 'Category'),\n  'Invoice Number: ' + invoiceNumber,\n  'Purchase Date: ' + value(product, 'Purchase_Date'),\n  'Seller: ' + value(product, 'Seller'),\n  'Warranty Valid Till: ' + value(product, 'Warranty_Expiry_Date'),\n  '',\n  'Issue:',\n  issueDescription,\n  '',\n  'The product appears to be within the warranty period. Please guide me on the next steps for repair, replacement, or service under warranty.',\n  '',\n  'Regards,',\n  userName,\n  userEmail,\n  userPhone,\n].filter((line) => line !== undefined && line !== null).join('\\n');\nconst body = value(found, 'claim_email_body') || fallbackBody;\nconst now = new Date();\nconst emailSentAt = now.toISOString();\nconst followupDate = yyyyMmDd(addDays(now, 3));\nreturn [{ json: { ...found, can_send: true, claim_id: claimId, user_id: userId, chat_id: chatId, product_id: productId, to_email: toEmail, user_email: userEmail, user_name: userName, subject, body, email_sent_at: emailSentAt, followup_date: followupDate, reply_text: 'Claim email sent.\\n\\nTo: ' + toEmail + '\\nCC: ' + userEmail + '\\n\\nClaim Status: Email Sent\\nFollow-up Date: ' + followupDate } }];"
      },
